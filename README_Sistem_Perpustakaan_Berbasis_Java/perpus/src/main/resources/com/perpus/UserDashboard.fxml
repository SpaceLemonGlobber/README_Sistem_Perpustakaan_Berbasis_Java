<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpus.app.controllers.UserDashboardController">
   <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label text="Member Readme">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Logout" />
         </children>
      </HBox>
      
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="🔍 Search &amp; Borrow">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                  <TextField fx:id="searchField" onKeyReleased="#handleSearch" promptText="Masukkan judul buku..." />
                  <TableView fx:id="tableSearch" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colJudul" prefWidth="300.0" text="Judul Buku" />
                      <TableColumn fx:id="colStok" prefWidth="100.0" text="Stok Tersedia" />
                           <TableColumn fx:id="colKategori" prefWidth="132.2264404296875" text="Kategori" />
                           <TableColumn fx:id="colPenerbit" prefWidth="108.67926025390625" text="Penerbit" />
                           <TableColumn fx:id="colTahunTerbit" prefWidth="98.7169189453125" text="Tahun Terbit" />
                    </columns>
                  </TableView>
                  <Button maxWidth="Infinity" onAction="#handleBorrow" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="BORROW SELECTED BOOK" />
               </VBox>
            </content>
          </Tab>
          
          <Tab text="🔄 My Borrows &amp; Return">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                  <TableView fx:id="tableActive" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colActiveId" text="ID Pinjam" />
                      <TableColumn fx:id="colActiveJudul" text="Judul Buku" />
                      <TableColumn fx:id="colActiveJatuhTempo" text="Jatuh Tempo" /> <TableColumn fx:id="colActiveStatus" text="Status" /> 
                      </columns>
                  </TableView>
                  <Button maxWidth="Infinity" onAction="#handleReturn" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="RETURN SELECTED BOOK" />
               </VBox>
            </content>
          </Tab>

          <Tab text="📜 View History">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                  <TableView fx:id="tableHistory" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colHistId" text="ID" />
                      <TableColumn fx:id="colHistJudul" text="Buku" />
                      <TableColumn fx:id="colHistTglPinjam" text="Tgl Pinjam" />
                      <TableColumn fx:id="colHistStatus" text="Status" />
                      <TableColumn fx:id="colHistDenda" text="Denda" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                  </TableView>
               </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>