<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpus.app.controllers.LoginController">
   <children>
      <Label text="LOGIN README">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox maxWidth="300.0" spacing="10.0">
         <children>
            <Label text="Username" />
            <TextField fx:id="usernameField" promptText="Masukkan Username" />
            <Label text="Password" />
            <PasswordField fx:id="passwordField" promptText="Masukkan Password" />
         </children>
      </VBox>
      <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white;" text="Login">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Label fx:id="statusLabel" textFill="RED" />
   </children>
   <padding>
      <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
   </padding>
</VBox>
