<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="750.0" spacing="15.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpus.app.controllers.BukuController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Manajemen Data Buku">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="searchField" prefHeight="31.0" prefWidth="400.0" promptText="Cari berdasarkan Judul, Kategori, atau Penerbit..." />
            <Button mnemonicParsing="false" onAction="#handleSearch" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Cari" />
            <HBox alignment="TOP_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Button mnemonicParsing="false" onAction="#showAddDialog" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="+ Tambah Buku" />
               </children>
            </HBox>
         </children>
      </HBox>
      
      <TableView fx:id="bukuTable" prefHeight="350.0" prefWidth="710.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colJudul" prefWidth="180.0" text="Judul" />
          <TableColumn fx:id="colPenerbit" prefWidth="120.0" text="Penerbit" />
          <TableColumn fx:id="colTahun" prefWidth="100.0" text="Tahun Terbit" />
          <TableColumn fx:id="colStok" prefWidth="70.0" text="Stok" />
          <TableColumn fx:id="colKategori" prefWidth="100.0" text="Kategori" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <HBox spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleEdit" prefWidth="80.0" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Edit" />
            <Button mnemonicParsing="false" onAction="#handleDelete" prefWidth="80.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Hapus" />
         </children>
      </HBox>
   </children>
</VBox>
