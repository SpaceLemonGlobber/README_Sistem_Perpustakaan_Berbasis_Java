<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpus.app.controllers.DashboardController">
   <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox>
               <children>
                  <Label style="-fx-font-weight: bold;" text="Admin Control Panel">
                     <font><Font size="22.0" /></font>
                  </Label>
                  <Label fx:id="adminLabel" text="Halo, Admin" textFill="#7f8c8d" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="LOGOUT" />
         </children>
      </HBox>

      <TabPane style="-fx-background-color: white; -fx-border-color: #dcdde1;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab text="📚 Kelola Buku">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                  <HBox spacing="10.0">
                     <TextField fx:id="searchBukuField" onKeyReleased="#handleSearchBuku" promptText="Cari judul atau penerbit..." HBox.hgrow="ALWAYS" />
                     <Button onAction="#showAddBuku" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="+ Tambah Buku" />
                  </HBox>
                  <TableView fx:id="tableBuku" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colBukuId" prefWidth="50" text="ID" />
                      <TableColumn fx:id="colJudul" prefWidth="300" text="Judul Buku" />
                      <TableColumn fx:id="colPenerbit" prefWidth="150" text="Penerbit" />
                      <TableColumn fx:id="colKategori" prefWidth="150" text="Kategori" />
                      <TableColumn fx:id="colStok" prefWidth="80" text="Stok" />
                      <TableColumn fx:id="colAksi" prefWidth="150" text="Aksi" />
                    </columns>
                  </TableView>
               </VBox>
            </content>
          </Tab>

          <Tab text="👥 Data Anggota">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                  <TableView fx:id="tableAnggota" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colAnggotaId" prefWidth="50" text="ID" />
                      <TableColumn fx:id="colNama" prefWidth="250" text="Nama Lengkap" />
                      <TableColumn fx:id="colEmail" prefWidth="200" text="Email" />
                    </columns>
                  </TableView>
               </VBox>
            </content>
          </Tab>

          <Tab text="🔄 Transaksi Aktif">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                  <TableView fx:id="tableTransaksi" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colTransId" text="ID Pinjam" />
                      <TableColumn fx:id="colTransUser" text="Peminjam" />
                      <TableColumn fx:id="colTransBuku" text="Buku" />
                      <TableColumn fx:id="colTransStatus" text="Status" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                  </TableView>
               </VBox>
            </content>
          </Tab>

        <Tab text="📂 Kategori Buku">
        <content>
            <VBox spacing="10.0">
                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                <HBox spacing="10.0">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Daftar Kategori Master" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleTambahKategori" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="+ Kategori Baru" />
                </HBox>
                <TableView fx:id="tableKategori" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colKategoriId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNamaKategori" prefWidth="250" text="Nama Kategori" />
                    <TableColumn fx:id="colDeskripsi" prefWidth="400" text="Deskripsi" />
                           <TableColumn fx:id="colAksiKategori" prefWidth="75.0" text="Aksi" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </VBox>
        </content>
        </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>
