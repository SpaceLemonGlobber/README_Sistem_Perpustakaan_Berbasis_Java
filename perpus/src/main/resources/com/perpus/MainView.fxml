<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpus.app.controllers.DashboardController">
   <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox>
               <children>
                  <Label text="Admin Control Panel" style="-fx-font-weight: bold;">
                     <font><Font size="22.0" /></font>
                  </Label>
                  <Label fx:id="adminLabel" text="Halo, Admin" textFill="#7f8c8d" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="LOGOUT" />
         </children>
      </HBox>

      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #dcdde1;">
        <tabs>
          <Tab text="📚 Kelola Buku">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                  <HBox spacing="10.0">
                     <TextField fx:id="searchBukuField" promptText="Cari judul atau penerbit..." HBox.hgrow="ALWAYS" onKeyReleased="#handleSearchBuku"/>
                     <Button text="+ Tambah Buku" onAction="#showAddBuku" style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />
                  </HBox>
                  <TableView fx:id="tableBuku" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colBukuId" text="ID" prefWidth="50" />
                      <TableColumn fx:id="colJudul" text="Judul Buku" prefWidth="300" />
                      <TableColumn fx:id="colPenerbit" text="Penerbit" prefWidth="150" />
                      <TableColumn fx:id="colKategori" text="Kategori" prefWidth="150" />
                      <TableColumn fx:id="colStok" text="Stok" prefWidth="80" />
                      <TableColumn fx:id="colAksi" text="Aksi" prefWidth="150" />
                    </columns>
                  </TableView>
               </VBox>
            </content>
          </Tab>

          <Tab text="👥 Data Anggota">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                  <TableView fx:id="tableAnggota" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colAnggotaId" text="ID" prefWidth="50" />
                      <TableColumn fx:id="colNama" text="Nama Lengkap" prefWidth="250" />
                      <TableColumn fx:id="colEmail" text="Email" prefWidth="200" />
                    </columns>
                  </TableView>
               </VBox>
            </content>
          </Tab>

          <Tab text="🔄 Transaksi Aktif">
            <content>
               <VBox spacing="10.0">
                  <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                  <TableView fx:id="tableTransaksi" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colTransId" text="ID Pinjam" />
                      <TableColumn fx:id="colTransUser" text="Peminjam" />
                      <TableColumn fx:id="colTransBuku" text="Buku" />
                      <TableColumn fx:id="colTransStatus" text="Status" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                  </TableView>
               </VBox>
            </content>
          </Tab>

        <Tab text="📂 Kategori Buku">
        <content>
            <VBox spacing="10.0">
                <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
                <HBox spacing="10.0">
                <Label text="Daftar Kategori Master" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="+ Kategori Baru" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                </HBox>
                <TableView fx:id="tableKategori" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colKategoriId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colNamaKategori" text="Nama Kategori" prefWidth="250" />
                    <TableColumn fx:id="colDeskripsi" text="Deskripsi" prefWidth="400" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
            </VBox>
        </content>
        </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>